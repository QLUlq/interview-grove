# Copy to .env, then fill in your own API key. Never share or commit .env.
INTERVIEW_API_KEY=
INTERVIEW_BASE_URL=https://api.openai.com/v1
INTERVIEW_MODEL=gpt-4.1-mini
# Optional ordered text fallbacks: only add models available to your own account.
# For Aliyun free use, enable "free quota only" for EVERY configured model in its console.
# INTERVIEW_FALLBACK_MODELS=qwen-max
# Images use a separate list; never put text-only or OCR-only models here.
# INTERVIEW_VISION_MODELS=qwen3.5-plus-2026-02-15
# 阿里云 qwen3.7-plus 默认关闭深度思考以减少结构化请求等待；设 true 可启用
# INTERVIEW_THINKING=false
PORT=3001
